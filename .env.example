# Copy to .env and fill in. Never commit .env.

# ── Server ──────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8000      # your public https URL once deployed (used in transcript links)
WEBHOOK_TOKEN=                             # any long random string; add ?token=<it> to the URL you give Vaani
LINK_SECRET=                               # any long random string; signs transcript links
DB_PATH=data/aangan.db
DEMO_SEED=false                            # true = load T01–T20 demo calls into an empty database on startup

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                        # from @BotFather. Blank = DRY RUN (messages go to data/outbox.log)
TELEGRAM_DESIGNERS_CHAT_ID=                # the designers group: qualified leads with a Claim button
TELEGRAM_URGENT_CHAT_ID=                   # Nikhil + senior people: complaints, priority repeat callers, stale leads
TELEGRAM_FRONTDESK_CHAT_ID=                # optional: "Ask" leads + review items. If blank they go to the digest only
TELEGRAM_WEBHOOK_SECRET=                   # any random string; Telegram echoes it back so we know callbacks are genuine

# ── Email digest ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                             # a Gmail "app password", not the account password
DIGEST_FROM=
DIGEST_TO=                                 # comma-separated, e.g. nikhil@…, frontdesk@…
SCHEDULER_ENABLED=true                     # re-alerts + daily digest (in-process loop; off on Vercel)
CRON_TOKEN=                                # protects /tasks/tick, for an external cron when the loop is off

# ── Dashboard ───────────────────────────────────────────
DASHBOARD_PASSWORD=                        # browser login; username is "aangan". Blank = no login (local only!)
